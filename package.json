{
  "name": "personal-assistant-web",
  "version": "0.1.0",
  "private": true,
  "description": "YayaMind desktop cat assistant",
  "author": "YayaMind",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx server/index.ts",
    "desktop:dev": "concurrently -k \"npm:dev:server\" \"npm run dev:web -- --strictPort\" \"npm:desktop:electron\"",
    "desktop:open": "electron electron/main.cjs",
    "desktop:electron": "electron electron/main.cjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --resolve-extensions=.ts,.js --outfile=dist-server/index.cjs",
    "build:desktop": "npm run build && npm run build:server",
    "desktop:pack": "npm run build:desktop && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set ELECTRON_CACHE=D:\\YayaMindBuild\\cache\\electron&& set ELECTRON_BUILDER_CACHE=D:\\YayaMindBuild\\cache\\electron-builder&& electron-builder --win --dir --config.directories.output=D:\\YayaMindBuild\\release",
    "desktop:dist": "npm run build:desktop && set CSC_IDENTITY_AUTO_DISCOVERY=false&& set ELECTRON_CACHE=D:\\YayaMindBuild\\cache\\electron&& set ELECTRON_BUILDER_CACHE=D:\\YayaMindBuild\\cache\\electron-builder&& electron-builder --win --config.directories.output=D:\\YayaMindBuild\\release",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.yayamind.desktop",
    "productName": "YayaMind",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "src/assets/desktop/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "src/assets/desktop/yayamind.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "YayaMind",
      "menuCategory": true,
      "runAfterFinish": true,
      "installerIcon": "src/assets/desktop/yayamind.ico",
      "uninstallerIcon": "src/assets/desktop/yayamind.ico",
      "installerHeaderIcon": "src/assets/desktop/yayamind.ico",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false
    }
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
